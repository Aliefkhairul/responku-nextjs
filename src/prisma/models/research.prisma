// ============================================================
// RESEARCH: researches, researchCriteria, researchQuestions,
//           researchQuestionChoices
// ============================================================

enum ResearchStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  CLOSED
  COMPLETED
  REJECTED
  CANCELLED
}

enum CriteriaOperator {
  EQ
  NEQ
  IN
  NOT_IN
  GT
  GTE
  LT
  LTE
  BETWEEN
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT
  NUMBER
  SCALE
}

// Kategori topik riset. Nilai enum adalah key stabil yang disimpan di database; label
// tampilannya ada di UI (`@/lib/research-category`).
enum ResearchCategory {
  ENVIRONMENT_ECOLOGY
  DISASTER_MANAGEMENT
  PUBLIC_HEALTH
  SOCIO_ECONOMICS
  PUBLIC_POLICY_LAW
  ATMOSPHERIC_CLIMATE_SCIENCE
  COMPUTER_SCIENCE_IT
  ARTIFICIAL_INTELLIGENCE
  DATA_SCIENCE_STATISTICS
  INFORMATION_SYSTEMS
  ENGINEERING_TECHNOLOGY
  ELECTRICAL_ELECTRONICS
  CIVIL_ARCHITECTURE
  INDUSTRIAL_MANUFACTURING
  BUSINESS_MANAGEMENT
  ECONOMICS_FINANCE
  ACCOUNTING_TAXATION
  MARKETING_ADVERTISING
  ENTREPRENEURSHIP
  HUMAN_RESOURCES
  EDUCATION_PEDAGOGY
  PSYCHOLOGY
  SOCIOLOGY_ANTHROPOLOGY
  COMMUNICATION_MEDIA
  POLITICAL_SCIENCE
  INTERNATIONAL_RELATIONS
  LAW_LEGAL_STUDIES
  PUBLIC_ADMINISTRATION
  AGRICULTURE_AGRONOMY
  FORESTRY
  FISHERIES_MARINE
  ANIMAL_HUSBANDRY
  FOOD_NUTRITION
  MEDICINE_CLINICAL_HEALTH
  PHARMACY_PHARMACEUTICAL
  NURSING_MIDWIFERY
  EPIDEMIOLOGY
  BIOTECHNOLOGY
  BIOLOGY_LIFE_SCIENCES
  CHEMISTRY
  PHYSICS
  MATHEMATICS
  ASTRONOMY_SPACE_SCIENCE
  ENERGY_RENEWABLE_RESOURCES
  TRANSPORTATION_LOGISTICS
  URBAN_REGIONAL_PLANNING
  GEOGRAPHY_GEOSPATIAL
  TOURISM_HOSPITALITY
  DESIGN_CREATIVE_INDUSTRIES
  ARTS_CULTURE
  LANGUAGE_LITERATURE
  HISTORY_ARCHAEOLOGY
  PHILOSOPHY_ETHICS
  RELIGION_THEOLOGY
  GENDER_DEVELOPMENT_STUDIES
  SOCIAL_WELFARE
  CRIMINOLOGY_SECURITY
  SPORTS_EXERCISE_SCIENCE
  OTHER
}

model Research {
  id          String @id @default(cuid()) @db.VarChar(36)
  researcherId String @db.VarChar(36)

  title             String  @db.VarChar(255)
  description       String  @db.Text
  category          ResearchCategory?
  externalSurveyUrl String? @db.VarChar(2048)

  targetRespondentCount    Int
  // Token yang diterima tiap responden; dikalikan target saat publish untuk reserve
  tokenPerRespondent       Int      @default(1)
  estimatedDurationMinutes Int
  deadline                 DateTime @db.DateTime(3)

  status         ResearchStatus @default(DRAFT)
  tokensReserved Int            @default(0)
  tokensConsumed Int            @default(0)
  publishedAt    DateTime?      @db.DateTime(3)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  researcher User @relation("ResearcherResearches", fields: [researcherId], references: [id])

  criteria       ResearchCriteria[]
  questions      ResearchQuestion[]
  participations RespondentParticipation[]
  transactions   TokenTransaction[]
  reports        ContentReport[]

  @@index([researcherId])
  @@index([status, deadline])
  @@map("researches")
}

model ResearchCriteria {
  id         String @id @default(cuid()) @db.VarChar(36)
  researchId String @db.VarChar(36)

  field    String           @db.VarChar(100)
  operator CriteriaOperator
  value    String           @db.VarChar(512)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  research Research @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@index([researchId])
  @@map("research_criteria")
}

model ResearchQuestion {
  id         String @id @default(cuid()) @db.VarChar(36)
  researchId String @db.VarChar(36)

  pos          Int
  question     String       @db.Text
  questionType QuestionType
  mustFill     Boolean      @default(true)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  research Research                 @relation(fields: [researchId], references: [id], onDelete: Cascade)
  choices  ResearchQuestionChoice[]
  answers  ParticipationAnswer[]

  @@unique([researchId, pos])
  @@map("research_questions")
}

model ResearchQuestionChoice {
  id         String @id @default(cuid()) @db.VarChar(36)
  questionId String @db.VarChar(36)

  pos        Int
  // Kode/label singkat pilihan (mis. "A", "B", "1"), sesuai kolom `n` di ERD
  n          String  @db.VarChar(20)
  choiceText String? @db.Text

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  question ResearchQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, pos])
  @@map("research_question_choices")
}
